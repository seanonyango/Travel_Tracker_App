BoxLayout:
    # Divide into two horizontal boxes
    orientation: "horizontal"

    BoxLayout:# create left side box
        size_hint_x: 0.2
        orientation: "vertical"

        Label:
            text: "Sort by:"
        Spinner:
            id: sort_spinner
            text: 'Visited'
            values: ['Visited', 'Priority', 'Country', 'Name']
            on_text: app.display_places(self.text)

        Label:
            text: 'Add new Place'
        Label:
            text: 'Name'
        TextInput:
            id: name_input
            # Limit input to one line and allow tab key to move between fields
            multiline: False
            write_tab: False

        Label:
            text: 'Country'
        TextInput:
            id: country_input
            multiline: False
            write_tab: False

        Label:
            text: 'Priority'
        TextInput:
            id: priority_input
            multiline: False
            write_tab: False

        Button:
            text: 'Add Place'
            on_press: app.add_new_place()
        Button:
            text: 'Clear'
            on_press: app.handle_clear()

    BoxLayout:# Create right_side box
        size_hint_x: 0.8
        orientation: "vertical"

        BoxLayout:
            size_hint_y: 0.8
            orientation: "vertical"

            Label:
                id: number_of_unvisited_display
                size_hint_y: 0.1
            BoxLayout:# Add buttons for each place here
                id: places
                orientation: 'vertical'
        BoxLayout:
            size_hint_y: 0.1
            Label:
                id: welcome_message
                text: "Welcome to Travel Tracker 2.0"